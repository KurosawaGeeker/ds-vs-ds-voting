{
  "name": "ds-vs-ds-payments-dev",
  "main": "dev-worker.js",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "routes": [],
  "ratelimits": [
    {
      "name": "VOTE_LIMIT",
      "namespace_id": "281001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "VOTE_GLOBAL_LIMIT",
      "namespace_id": "281002",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "SELECTION_LIMIT",
      "namespace_id": "281003",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "RESULTS_REFRESH",
      "namespace_id": "281004",
      "simple": {
        "limit": 1,
        "period": 10
      }
    },
    {
      "name": "DB_READ_LIMIT",
      "namespace_id": "281005",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    {
      "name": "PAYMENT_READ_LIMIT",
      "namespace_id": "281010",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "PAYMENT_WRITE_LIMIT",
      "namespace_id": "281011",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "PAYMENT_GLOBAL_LIMIT",
      "namespace_id": "281012",
      "simple": {
        "limit": 100,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": false
  },
  "vars": {
    "ALLOWED_ORIGINS": [
      "http://127.0.0.1:8000",
      "http://localhost:8000"
    ],
    "PUBLIC_ORIGIN": "http://127.0.0.1:8000",
    "RUNTIME_ENV": "development",
    "PAYMENTS_ENABLED": "false",
    "PAYMENT_LEDGER_ENABLED": "false",
    "MAX_PAYMENT_MINOR": "10000",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "XORPAY_LIVE_ENABLED": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "original-voting-review-local",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "limits": {
    "cpu_ms": 100
  },
  "assets": {
    "directory": "../docs",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "preview_urls": false
}
