{
  "name": "ds-vs-ds-api",
  "main": "worker.js",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "ratelimits": [
    {
      "name": "VOTE_LIMIT",
      "namespace_id": "270901",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "VOTE_GLOBAL_LIMIT",
      "namespace_id": "270902",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "SELECTION_LIMIT",
      "namespace_id": "270903",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "RESULTS_REFRESH",
      "namespace_id": "270904",
      "simple": {
        "limit": 1,
        "period": 10
      }
    },
    {
      "name": "DB_READ_LIMIT",
      "namespace_id": "270905",
      "simple": {
        "limit": 300,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": false
  },
  "vars": {
    "ALLOWED_ORIGINS": [
      "http://127.0.0.1:8000",
      "http://localhost:8000"
    ],
    "PAYMENTS_ENABLED": "false",
    "PAYMENT_LEDGER_ENABLED": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "original-voting-review-local",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "limits": {
    "cpu_ms": 50
  }
}
